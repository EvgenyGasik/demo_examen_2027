        <TextBlock Grid.Row="0"
                   Text=""
                   HorizontalAlignment="Right"
                   FontSize="30"
                   x:Name="userName"/>
        <Frame Grid.Row="1"
               x:Name="mainFrame"/>
    </Grid>
</Window>
